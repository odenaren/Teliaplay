# ---------------------------------------------------------------------------
# Kopiera till .env och fyll i. INGET av detta ska checkas in i git.
#
# OBS: .env.local har HÖGRE prioritet än .env i Next. Har du båda är det
# .env.local som gäller — det är en timmes felsökning värd att slippa.
# ---------------------------------------------------------------------------

# OBLIGATORISKT ------------------------------------------------------------
# Vilken Postgres som helst duger. TLS slås på automatiskt utom mot localhost
# och Railways interna nätverk.
#
#   Neon (gratis):    postgresql://user:LOSEN@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   Railway Postgres: postgresql://postgres:LOSEN@postgres.railway.internal:5432/railway
#
# Specialtecken i lösenordet måste URL-kodas: @ blir %40, # blir %23, / blir %2F.
# Kör `npm run db:check` så säger den till om något är fel.
DATABASE_URL=

# Skydd för /api/ingest så inte vem som helst kan trigga hämtningar utifrån.
# Uppdatera-knappen i appen går via en server action och behöver den inte.
# Generera med:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_SECRET=byt-ut-mig


# VAD SOM INGÅR ------------------------------------------------------------
# Dina Telia-uppgifter. Med dem hämtas kanallistan automatiskt från Telias eget
# API — samma inloggning som i deras app. Utan dem kryssar du i listan för hand
# på /ingar, vilket tar tio minuter en gång och aldrig går sönder.
#
# Uppgifterna används bara mot Telia, loggas aldrig, och skickas ingen
# annanstans. Testa dem med `npm run telia:login`.
# TELIA_USERNAME=
# TELIA_PASSWORD=


# FILM OCH SERIER ----------------------------------------------------------
# Gratis nyckel från themoviedb.org/settings/api. Utan den hämtas ingen
# film- och seriekatalog; tablå och sport fungerar ändå.
#
# Tillgänglighetsdatan kommer från JustWatch via TMDB och kräver attribution —
# den ligger på /kallor och ska inte tas bort.
# TMDB_API_KEY=

# TheSportsDB. "3" är den öppna testnyckeln och räcker för ett hushåll.
# SPORTSDB_KEY=3


# VALVET -------------------------------------------------------------------
# 32 byte base64. Krypterar lösenord och 2FA-nycklar i databasen.
# Generera med:  npm run vault:key
#
# BYTER DU DEN GÅR ALLT SPARAT FÖRLORAT. Den finns bara här, aldrig i
# databasen — vilket är precis vad som gör en läckt dump obrukbar.
# VAULT_KEY=


# HEMBRYGGAN ---------------------------------------------------------------
# Tjänsten hemma som styr Apple TV:n. Se bridge/README.md.
# Utan den öppnar Spela-knapparna länkar i stället, vilket också fungerar.
# BRIDGE_URL=https://din-tunnel.trycloudflare.com
# BRIDGE_SECRET=samma-som-pa-bryggan


# VALFRITT -----------------------------------------------------------------
# Fast hämtningsintervall i minuter (minst 5). Utan detta: var 20:e minut för
# tablån, en gång per dygn för filmkatalogen.
# INGEST_INTERVAL_MINUTES=20

# Stäng av den inbyggda schemaläggaren helt.
# INGEST_SCHEDULER=off

# Antal samtidiga databasanslutningar.
# DB_POOL_MAX=8

# Landskod mot Telias API. Bara 'se' är testad.
# TELIA_COUNTRY=se

# Appens egen publika adress. Behövs bara av `npm run ingest`, som annars
# skickar hämtningen till localhost. På Railway: https://<tjänst>.up.railway.app
# APP_URL=

# User-Agent mot källorna. Standardvärdet räcker; sätt den bara om tv.nu eller
# SVT börjar neka anrop.
# HTTP_USER_AGENT=

# Sätts automatiskt av Railway.
PORT=3000
